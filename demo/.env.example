ANTHROPIC_API_KEY=

# Photos et vidéo (scripts/fetch-images.ts) : une des deux clés suffit. Inutile pour lancer la démo :
# les images sont déjà dans public/.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Optionnel : génération de packshots par IA (scripts/generate-images.ts)
OPENAI_API_KEY=
